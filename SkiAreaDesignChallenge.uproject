{
  "FileVersion": 3,
  "EngineAssociation": "5.8",
  "Category": "Simulation",
  "Description": "Mountain Planner native terrain preparation and runtime.",
  "Modules": [
    { "Name": "SkiDomain", "Type": "Runtime", "LoadingPhase": "Default" },
    { "Name": "SkiApplication", "Type": "Runtime", "LoadingPhase": "Default" },
